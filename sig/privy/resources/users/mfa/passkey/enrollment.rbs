    class Users
      class Mfa
        class Passkey
          class Enrollment
            def init: (
              String user_id,
              relying_party: String,
              user_jwt: String,
              ?mfa_token: String,
              ?request_options: Privy::request_opts
            ) -> Privy::Users::PasskeyMfaEnrollmentInitResponse

            def verify: (
              String user_id,
              credential: Privy::Users::MfaPasskeyAuthenticatorEnrollmentResponse,
              user_jwt: String,
              ?request_options: Privy::request_opts
            ) -> Privy::Users::MfaVerificationResponse

