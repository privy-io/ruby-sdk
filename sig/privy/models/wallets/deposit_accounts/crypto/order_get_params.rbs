module Privy
  module Models
    module Wallets
      module DepositAccounts
        module Crypto
          type order_get_params =
            { wallet_id: String, order_id: String }
            & Privy::Internal::Type::request_parameters

          class OrderGetParams < Privy::Internal::Type::BaseModel
            extend Privy::Internal::Type::RequestParameters::Converter
            include Privy::Internal::Type::RequestParameters

            attr_accessor wallet_id: String

            attr_accessor order_id: String

            def initialize: (
              wallet_id: String,
              order_id: String,
              ?request_options: Privy::request_opts
            ) -> void

            def to_hash: -> {
              wallet_id: String,
              order_id: String,
              request_options: Privy::RequestOptions
            }
          end
        end
      end
    end
  end
end
