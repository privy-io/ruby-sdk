module Privy
  module Models
    module Wallets
      type earn_fee_collect_request_body =
        { vault_id: String, nonce: String, reference_id: String }

      class EarnFeeCollectRequestBody < Privy::Internal::Type::BaseModel
        attr_accessor vault_id: String

        attr_reader nonce: String?

        def nonce=: (String) -> String

        attr_reader reference_id: String?

        def reference_id=: (String) -> String

        def initialize: (
          vault_id: String,
          ?nonce: String,
          ?reference_id: String
        ) -> void

        def to_hash: -> {
          vault_id: String,
          nonce: String,
          reference_id: String
        }
      end
    end
  end
end
