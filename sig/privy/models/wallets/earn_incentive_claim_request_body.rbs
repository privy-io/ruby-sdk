        attr_reader reference_id: String?

        def reference_id=: (String) -> String

        def initialize: (
          chain: String,
          ?nonce: String,
          ?reference_id: String
        ) -> void

        def to_hash: -> { chain: String, nonce: String, reference_id: String }
