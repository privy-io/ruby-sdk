module Privy
  module Models
    module WalletActionType = Wallets::WalletActionType

    module Wallets
      type wallet_action_type =
        :swap
        | :transfer
        | :earn_deposit
        | :earn_withdraw
        | :earn_incentive_claim
        | :earn_fee_collect
        | :payout
        | :tmmf_deposit
        | :tmmf_withdraw
        | String

      module WalletActionType
        extend Privy::Internal::Type::Union

        def self?.variants: -> ::Array[Privy::Models::Wallets::wallet_action_type]

        SWAP: :swap
        TRANSFER: :transfer
        EARN_DEPOSIT: :earn_deposit
        EARN_WITHDRAW: :earn_withdraw
        EARN_INCENTIVE_CLAIM: :earn_incentive_claim
        EARN_FEE_COLLECT: :earn_fee_collect
        PAYOUT: :payout
        TMMF_DEPOSIT: :tmmf_deposit
        TMMF_WITHDRAW: :tmmf_withdraw
      end
    end
  end
end
