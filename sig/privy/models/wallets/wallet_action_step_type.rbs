module Privy
  module Models
    module WalletActionStepType = Wallets::WalletActionStepType

    module Wallets
      type wallet_action_step_type =
        :evm_transaction
        | :evm_user_operation
        | :svm_transaction
        | :tvm_transaction
        | :external_transaction
        | :custodian_transaction
        | :tempo_zone_settlement
        | String

      module WalletActionStepType
        extend Privy::Internal::Type::Union

        def self?.variants: -> ::Array[Privy::Models::Wallets::wallet_action_step_type]

        EVM_TRANSACTION: :evm_transaction
        EVM_USER_OPERATION: :evm_user_operation
        SVM_TRANSACTION: :svm_transaction
        TVM_TRANSACTION: :tvm_transaction
        EXTERNAL_TRANSACTION: :external_transaction
        CUSTODIAN_TRANSACTION: :custodian_transaction
        TEMPO_ZONE_SETTLEMENT: :tempo_zone_settlement
      end
    end
  end
end
