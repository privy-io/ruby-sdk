module Privy
  module Models
    module Wallets
      type tmmf_withdraw_request_body =
        {
          chain: String,
          fund: String,
          order_type: Privy::Models::Wallets::tmmf_order_type,
          shares: String,
          withdraw_asset: String,
          nonce: String,
          reference_id: String
        }

      class TmmfWithdrawRequestBody < Privy::Internal::Type::BaseModel
        attr_accessor chain: String

        attr_accessor fund: String

        attr_accessor order_type: Privy::Models::Wallets::tmmf_order_type

        attr_accessor shares: String

        attr_accessor withdraw_asset: String

        attr_reader nonce: String?

        def nonce=: (String) -> String

        attr_reader reference_id: String?

        def reference_id=: (String) -> String

        def initialize: (
          chain: String,
          fund: String,
          order_type: Privy::Models::Wallets::tmmf_order_type,
          shares: String,
          withdraw_asset: String,
          ?nonce: String,
          ?reference_id: String
        ) -> void

        def to_hash: -> {
          chain: String,
          fund: String,
          order_type: Privy::Models::Wallets::tmmf_order_type,
          shares: String,
          withdraw_asset: String,
          nonce: String,
          reference_id: String
        }
      end
    end
  end
end
