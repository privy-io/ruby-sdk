module Privy
  module Models
    module Wallets
      module Earn
        module Ethereum
          type incentive_list_params =
            { wallet_id: String, chain: String }
            & Privy::Internal::Type::request_parameters

          class IncentiveListParams < Privy::Internal::Type::BaseModel
            extend Privy::Internal::Type::RequestParameters::Converter
            include Privy::Internal::Type::RequestParameters

            attr_accessor wallet_id: String

            attr_accessor chain: String

            def initialize: (
              wallet_id: String,
              chain: String,
              ?request_options: Privy::request_opts
            ) -> void

            def to_hash: -> {
              wallet_id: String,
              chain: String,
              request_options: Privy::RequestOptions
            }
          end
        end
      end
    end
  end
end
