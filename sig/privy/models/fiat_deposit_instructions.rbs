      attr_reader payment_rails: ::Array[String]?

      def payment_rails=: (::Array[String]) -> ::Array[String]

      attr_reader sort_code: String?

      def sort_code=: (String) -> String

      def initialize: (
        ?account_holder_name: String,
        ?account_number: String,
        ?bank_account_number: String,
        ?bank_address: String,
        ?bank_beneficiary_address: String,
        ?bank_beneficiary_name: String,
