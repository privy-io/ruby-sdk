module Privy
  module Models
    type kyb_publicly_traded_listing =
      { market_identifier_code: String, stock_number: String, ticker: String }

    class KYBPubliclyTradedListing < Privy::Internal::Type::BaseModel
      attr_accessor market_identifier_code: String

      attr_accessor stock_number: String

      attr_accessor ticker: String

      def initialize: (
        market_identifier_code: String,
        stock_number: String,
        ticker: String
      ) -> void

      def to_hash: -> {
        market_identifier_code: String,
        stock_number: String,
        ticker: String
      }
    end
  end
end
