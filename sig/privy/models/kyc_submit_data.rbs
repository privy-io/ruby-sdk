module Privy
  module Models
    type kyc_submit_data =
      {
        date_of_birth: String,
        first_name: String,
        identifying_information: ::Array[Privy::KYCIdentifyingDocument],
        last_name: String,
        residential_address: Privy::KYCResidentialAddress,
        email: String,
        phone: String
      }

    class KYCSubmitData < Privy::Internal::Type::BaseModel
      attr_accessor date_of_birth: String

      attr_accessor first_name: String

      attr_accessor identifying_information: ::Array[Privy::KYCIdentifyingDocument]

      attr_accessor last_name: String

      attr_accessor residential_address: Privy::KYCResidentialAddress

      attr_reader email: String?

      def email=: (String) -> String

      attr_reader phone: String?

      def phone=: (String) -> String

      def initialize: (
        date_of_birth: String,
        first_name: String,
        identifying_information: ::Array[Privy::KYCIdentifyingDocument],
        last_name: String,
        residential_address: Privy::KYCResidentialAddress,
        ?email: String,
        ?phone: String
      ) -> void

      def to_hash: -> {
        date_of_birth: String,
        first_name: String,
        identifying_information: ::Array[Privy::KYCIdentifyingDocument],
        last_name: String,
        residential_address: Privy::KYCResidentialAddress,
        email: String,
        phone: String
      }
    end
  end
end
