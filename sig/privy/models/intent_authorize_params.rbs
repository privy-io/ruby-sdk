module Privy
  module Models
    type intent_authorize_params =
      { intent_id: String } & Privy::Internal::Type::request_parameters

    class IntentAuthorizeParams < Privy::Models::IntentAuthorizeInput
      extend Privy::Internal::Type::RequestParameters::Converter
      include Privy::Internal::Type::RequestParameters

      def intent_id: -> String

      def intent_id=: (String _) -> String

      def initialize: (
        intent_id: String,
        ?request_options: Privy::request_opts
      ) -> void

      def to_hash: -> {
        intent_id: String,
        request_options: Privy::RequestOptions
      }
    end
  end
end
