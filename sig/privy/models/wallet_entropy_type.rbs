module Privy
  module Models
    type wallet_entropy_type = :hd | :"private-key" | :"ed25519-scalar" | String

    module WalletEntropyType
      extend Privy::Internal::Type::Union

      def self?.variants: -> ::Array[Privy::Models::wallet_entropy_type]

      HD: :hd
      PRIVATE_KEY: :"private-key"
      ED25519_SCALAR: :"ed25519-scalar"
    end
  end
end
