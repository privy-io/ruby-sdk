module Privy
  module Models
    type email_mfa_method =
      { type: Privy::Models::EmailMfaMethod::type_, verified_at: Float }

    class EmailMfaMethod < Privy::Internal::Type::BaseModel
      attr_accessor type: Privy::Models::EmailMfaMethod::type_

      attr_accessor verified_at: Float

      def initialize: (
        type: Privy::Models::EmailMfaMethod::type_,
        verified_at: Float
      ) -> void

      def to_hash: -> {
        type: Privy::Models::EmailMfaMethod::type_,
        verified_at: Float
      }

      type type_ = :email

      module Type
        extend Privy::Internal::Type::Enum

        EMAIL: :email

        def self?.values: -> ::Array[Privy::Models::EmailMfaMethod::type_]
      end
    end
  end
end
