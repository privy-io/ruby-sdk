module Privy
  module Models
    type intent_type =
      :CONDITION_SET_ITEM
      | :KEY_QUORUM
      | :POLICY
      | :RAW_SIGN
      | :RULE
      | :RPC
      | :TRANSFER
      | :WALLET
      | String

    module IntentType
      extend Privy::Internal::Type::Union

      def self?.variants: -> ::Array[Privy::Models::intent_type]

      CONDITION_SET_ITEM: :CONDITION_SET_ITEM
      KEY_QUORUM: :KEY_QUORUM
      POLICY: :POLICY
      RAW_SIGN: :RAW_SIGN
      RULE: :RULE
      RPC: :RPC
      TRANSFER: :TRANSFER
      WALLET: :WALLET
    end
  end
end
