module Privy
  module Models
    type policies_response =
      { data: ::Array[Privy::PolicyListItem], next_cursor: String? }

    class PoliciesResponse < Privy::Internal::Type::BaseModel
      attr_accessor data: ::Array[Privy::PolicyListItem]

      attr_accessor next_cursor: String?

      def initialize: (
        data: ::Array[Privy::PolicyListItem],
        next_cursor: String?
      ) -> void

      def to_hash: -> {
        data: ::Array[Privy::PolicyListItem],
        next_cursor: String?
      }
    end
  end
end
