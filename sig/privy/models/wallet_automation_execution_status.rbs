module Privy
  module Models
    type wallet_automation_execution_status =
      :pending | :submitted | :completed | :failed | :skipped

    module WalletAutomationExecutionStatus
      extend Privy::Internal::Type::Enum

      PENDING: :pending
      SUBMITTED: :submitted
      COMPLETED: :completed
      FAILED: :failed
      SKIPPED: :skipped

      def self?.values: -> ::Array[Privy::Models::wallet_automation_execution_status]
    end
  end
end
