module Privy
  module Models
    type crypto_deposit_account_search_currency =
      {
        chains: ::Array[Privy::CryptoDepositAccountSourceChain],
        name: String,
        symbol: String,
        verified: bool,
        logo_uri: String
      }

    class CryptoDepositAccountSearchCurrency < Privy::Internal::Type::BaseModel
      attr_accessor chains: ::Array[Privy::CryptoDepositAccountSourceChain]

      attr_accessor name: String

      attr_accessor symbol: String

      attr_accessor verified: bool

      attr_reader logo_uri: String?

      def logo_uri=: (String) -> String

      def initialize: (
        chains: ::Array[Privy::CryptoDepositAccountSourceChain],
        name: String,
        symbol: String,
        verified: bool,
        ?logo_uri: String
      ) -> void

      def to_hash: -> {
        chains: ::Array[Privy::CryptoDepositAccountSourceChain],
        name: String,
        symbol: String,
        verified: bool,
        logo_uri: String
      }
    end
  end
end
