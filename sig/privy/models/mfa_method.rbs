module Privy
  module Models
    type mfa_method = :sms | :totp | :passkey | :email

    module MfaMethod
      extend Privy::Internal::Type::Enum

      SMS: :sms
      TOTP: :totp
      PASSKEY: :passkey
      EMAIL: :email

      def self?.values: -> ::Array[Privy::Models::mfa_method]
    end
  end
end
