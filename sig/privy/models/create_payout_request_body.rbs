module Privy
  module Models
    type create_payout_request_body =
      {
        destination: Privy::PayoutDestination,
        source: Privy::PayoutSource,
        developer_fee_percent: String,
        travel_rule: Privy::PayoutTravelRule
      }

    class CreatePayoutRequestBody < Privy::Internal::Type::BaseModel
      attr_accessor destination: Privy::PayoutDestination

      attr_accessor source: Privy::PayoutSource

      attr_reader developer_fee_percent: String?

      def developer_fee_percent=: (String) -> String

      attr_reader travel_rule: Privy::PayoutTravelRule?

      def travel_rule=: (Privy::PayoutTravelRule) -> Privy::PayoutTravelRule

      def initialize: (
        destination: Privy::PayoutDestination,
        source: Privy::PayoutSource,
        ?developer_fee_percent: String,
        ?travel_rule: Privy::PayoutTravelRule
      ) -> void

      def to_hash: -> {
        destination: Privy::PayoutDestination,
        source: Privy::PayoutSource,
        developer_fee_percent: String,
        travel_rule: Privy::PayoutTravelRule
      }
    end
  end
end
