module Privy
  module Models
    type card_issuing_transaction_response =
      {
        id: String,
        amount: Float,
        created: Float,
        currency: String,
        dispute: Privy::CardIssuingDispute?,
        merchant: Privy::CardIssuingMerchant,
        status: Privy::Models::card_issuing_transaction_status
      }

    class CardIssuingTransactionResponse < Privy::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor amount: Float

      attr_accessor created: Float

      attr_accessor currency: String

      attr_accessor dispute: Privy::CardIssuingDispute?

      attr_accessor merchant: Privy::CardIssuingMerchant

      attr_accessor status: Privy::Models::card_issuing_transaction_status

      def initialize: (
        id: String,
        amount: Float,
        created: Float,
        currency: String,
        dispute: Privy::CardIssuingDispute?,
        merchant: Privy::CardIssuingMerchant,
        status: Privy::Models::card_issuing_transaction_status
      ) -> void

      def to_hash: -> {
        id: String,
        amount: Float,
        created: Float,
        currency: String,
        dispute: Privy::CardIssuingDispute?,
        merchant: Privy::CardIssuingMerchant,
        status: Privy::Models::card_issuing_transaction_status
      }
    end
  end
end
